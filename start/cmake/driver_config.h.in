#ifndef EPP_GENERATED_DRIVER_CONFIG_H_
#define EPP_GENERATED_DRIVER_CONFIG_H_

// CMakeで確定した生成機能、リンクに使う処理系、実行ファイルの接尾辞。
#cmakedefine01 EPP_ENABLE_LLVM
#cmakedefine01 EPP_NATIVE_BUILD_ENABLED
#define EPP_LINK_DRIVER R"epp(@CMAKE_CXX_COMPILER@)epp"
#define EPP_EXECUTABLE_SUFFIX "@CMAKE_EXECUTABLE_SUFFIX@"

#endif  // EPP_GENERATED_DRIVER_CONFIG_H_
